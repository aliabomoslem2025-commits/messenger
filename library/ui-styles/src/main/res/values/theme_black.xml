<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BLACK THEME COLORS -->

    <style name="Base.Theme.Vector.Black" parent="Base.Theme.Vector.Dark">
        <!-- Only setting the items we need to override to get the background to be pure black, otherwise inheriting -->

        <!-- other colors -->
        <item name="vctr_fab_label_bg">@color/vctr_fab_label_bg_black</item>
        <item name="vctr_fab_label_stroke">@color/vctr_fab_label_stroke_black</item>
        <item name="vctr_fab_label_color">@color/vctr_fab_label_color_black</item>
        <item name="vctr_touch_guard_bg">@color/vctr_touch_guard_bg_black</item>
        <item name="vctr_room_active_widgets_banner_bg">@color/vctr_room_active_widgets_banner_bg_black</item>
        <item name="vctr_room_active_widgets_banner_text">@color/vctr_room_active_widgets_banner_text_black</item>
        <item name="vctr_reaction_background_off">@color/vctr_reaction_background_off_black</item>
        <item name="vctr_reaction_background_on">@color/vctr_reaction_background_on_black</item>
        <item name="vctr_markdown_block_background_color">#FF4D4D4D</item>
        <item name="vctr_chat_background">@color/vctr_chat_background_black</item>
        <item name="vctr_chat_wallpaper_doodle">@color/telegram_chat_wallpaper_doodle_black</item>
        <item name="vctr_room_list_background">@color/vctr_room_list_background_black</item>
        <item name="vctr_telegram_search_surface">@color/telegram_search_surface_black</item>
        <item name="vctr_telegram_tab_selected_background">@color/telegram_tab_selected_black</item>
        <item name="vctr_messenger_actionbar_background">@color/vctr_messenger_actionbar_background_black</item>
        <item name="vctr_telegram_send_accent">@color/telegram_brand_green_black</item>
        <!-- Override the inherited dark-theme message colors so black mode keeps distinct bubbles on a pure-black canvas. -->
        <item name="vctr_message_bubble_inbound">@color/vctr_message_bubble_inbound_black</item>
        <item name="vctr_message_bubble_outbound">@color/vctr_message_bubble_outbound_black</item>
        <item name="vctr_toolbar_background">@color/element_background_black</item>

        <!-- Material color -->
        <item name="colorSurface">@android:color/black</item>
        <item name="android:colorBackground">@color/element_background_black</item>

        <!-- Default theme -->
        <item name="bottomSheetDialogTheme">@style/Theme.Vector.BottomSheetDialog.Black</item>

        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.Vector.Black" parent="Base.Theme.Vector.Black" />

</resources>
