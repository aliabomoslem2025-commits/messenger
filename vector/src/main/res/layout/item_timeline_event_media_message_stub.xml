<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:viewBindingIgnore="true">

    <ImageView
        android:id="@+id/messageThumbnailView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/a11y_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_height="300dp"
        tools:src="@tools:sample/backgrounds/scenic" />

    <LinearLayout
        android:id="@+id/messageMediaTopStartControls"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_telegram_video_controls"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="9dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/messageThumbnailView"
        app:layout_constraintTop_toTopOf="@id/messageThumbnailView"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/messageMediaDownloadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/telegram_voice_download_message"
                android:padding="3dp"
                android:src="@drawable/ic_telegram_download_arrow"
                android:visibility="gone"
                app:tint="@android:color/white"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/messageMediaDownloadProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateDrawable="@drawable/bg_telegram_voice_download_indeterminate"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/messageMediaDurationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:text="0:20" />

            <TextView
                android:id="@+id/messageMediaSizeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                tools:text="721 KB" />

        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/messageMediaMoreView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_telegram_video_controls"
        android:contentDescription="@string/telegram_media_more_options"
        android:padding="7dp"
        android:src="@drawable/ic_more_vertical"
        android:visibility="gone"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="@id/messageThumbnailView"
        app:layout_constraintTop_toTopOf="@id/messageThumbnailView"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/messageMediaCaptionView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:gravity="start"
        android:textColor="?vctr_content_primary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/messageThumbnailView"
        tools:text="A caption for this photo"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/messageMediaPlayView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/action_play"
        android:src="@drawable/ic_material_play_circle"
        android:visibility="gone"
        app:tint="?vctr_system"
        app:layout_constraintBottom_toBottomOf="@id/messageThumbnailView"
        app:layout_constraintEnd_toEndOf="@id/messageThumbnailView"
        app:layout_constraintStart_toStartOf="@id/messageThumbnailView"
        app:layout_constraintTop_toTopOf="@id/messageThumbnailView"
        tools:visibility="visible" />

    <include
        android:id="@+id/messageMediaUploadProgressLayout"
        layout="@layout/media_upload_download_progress_layout"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/messageMediaCaptionView"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
