<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/view_download_replacement_app_room_list_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <include layout="@layout/view_download_replacement_app_room_list" />

    </FrameLayout>

    <im.vector.app.core.ui.views.KeysBackupBanner
        android:id="@+id/homeKeysBackupBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?vctr_keys_backup_banner_accent_color"
        android:minHeight="67dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_download_replacement_app_room_list_container"
        tools:visibility="gone" />

    <im.vector.app.core.ui.views.CurrentCallsView
        android:id="@+id/currentCallsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/homeKeysBackupBanner"
        tools:visibility="gone" />

    <im.vector.app.features.sync.widget.SyncStateView
        android:id="@+id/syncStateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/currentCallsView"
        tools:visibility="gone" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/telegramBottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/syncStateView">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?vctr_room_list_background"
            android:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                style="?attr/collapsingToolbarLayoutMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?vctr_room_list_background"
                app:collapsedTitleTextColor="?vctr_content_primary"
                app:contentScrim="?vctr_room_list_background"
                app:expandedTitleTextColor="?vctr_content_primary">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="?vctr_room_list_background"
                    android:elevation="0dp"
                    app:layout_collapseMode="pin"
                    tools:title="@string/telegram_home_title" />

                <ImageView
                    android:id="@+id/debug_button"
                    style="@style/VectorDebug"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_settings_x"
                    app:tint="?colorPrimary"
                    tools:ignore="MissingPrefix" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Pinned search field, matching Telegram's chat list. -->
            <LinearLayout
                android:id="@+id/telegramHomeSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_telegram_search"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_search"
                    app:tint="?vctr_content_secondary" />

                <EditText
                    android:id="@+id/telegramHomeSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/telegram_search_chats"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="?vctr_content_primary"
                    android:textColorHint="?vctr_content_secondary"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- A single segmented pill; tabs retain their real Matrix filters. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/telegramHomeTabs"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_telegram_filter_track"
                android:elevation="2dp"
                app:tabBackground="@drawable/bg_telegram_home_tab"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/telegram_accent_blue"
                app:tabTextColor="?vctr_content_secondary" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

            <im.vector.app.core.ui.views.VerifyDeviceBanner
                android:id="@+id/homeVerifyDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/roomListContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newLayoutOpenSpacesButton"
        style="@style/Widget.Vector.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:accessibilityTraversalAfter="@id/newLayoutCreateChatButton"
        android:contentDescription="@string/a11y_open_spaces"
        android:src="@drawable/ic_spaces"
        android:visibility="gone"
        app:backgroundTint="@color/telegram_accent_blue"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/newLayoutCreateChatButton"
        app:layout_constraintEnd_toEndOf="@id/newLayoutCreateChatButton"
        app:layout_constraintStart_toStartOf="@id/newLayoutCreateChatButton"
        app:tint="@android:color/white"
        tools:targetApi="lollipop_mr1"
        tools:visibility="visible" />


    <LinearLayout
        android:id="@+id/telegramBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_telegram_bottom_navigation"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/telegramTabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="true">

            <ImageView
                android:id="@+id/telegramTabChatsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone"
                android:contentDescription="@string/telegram_tab_chats"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_bottom_chat"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabChatsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_chats"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="14sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabContactsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone"
                android:contentDescription="@string/telegram_tab_contacts"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_baseline_perm_contact_calendar_24"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabContactsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_contacts"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="13sp"
                android:textStyle="medium" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone"
                android:contentDescription="@string/telegram_tab_settings"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_root_general"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_settings"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="13sp"
                android:textStyle="medium" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabProfileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/telegram_tab_profile"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_round"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_profile"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="13sp"
                android:textStyle="medium" />

        </LinearLayout>


    </LinearLayout>

    <ImageButton
        android:id="@+id/telegramCameraButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_telegram_camera_button"
        android:contentDescription="@string/telegram_open_camera"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_camera"
        app:layout_constraintBottom_toTopOf="@id/newLayoutCreateChatButton"
        app:layout_constraintEnd_toEndOf="@id/newLayoutCreateChatButton"
        app:tint="?vctr_content_secondary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newLayoutCreateChatButton"
        style="@style/Widget.Vector.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/a11y_create_message"
        android:src="@drawable/ic_fab_add_chat"
        android:visibility="gone"
        app:backgroundTint="@color/telegram_accent_blue"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/telegramBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        tools:targetApi="lollipop_mr1"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>
