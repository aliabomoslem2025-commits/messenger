<LinearLayout
                android:id="@+id/telegramHomeSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_telegram_search"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_search"
                    app:tint="?vctr_content_secondary" />

                <EditText
                    android:id="@+id/telegramHomeSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/telegram_search_chats"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="?vctr_content_primary"
                    android:textColorHint="?vctr_content_secondary"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Pinned Telegram-like folder filters; these operate on Matrix room queries. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/telegramHomeTabs"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_telegram_home_filters"
                android:elevation="3dp"
                android:padding="2dp"
                android:visibility="gone"
                app:tabBackground="@drawable/bg_telegram_filter_tab"
                app:tabGravity="fill"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabPaddingStart="6dp"
                app:tabPaddingEnd="6dp"
                app:tabRippleColor="@color/telegram_tab_ripple"
                app:tabSelectedTextColor="@color/telegram_accent_blue"
                app:tabTextColor="?vctr_content_secondary" />

            <im.vector.app.core.ui.views.VerifyDeviceBanner
                android:id="@+id/homeVerifyDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/roomListContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newLayoutOpenSpacesButton"
        style="@style/Widget.Vector.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:accessibilityTraversalAfter="@id/newLayoutCreateChatButton"
        android:contentDescription="@string/a11y_open_spaces"
        android:src="@drawable/ic_spaces"
        android:visibility="gone"
        app:backgroundTint="@color/telegram_accent_blue"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/newLayoutCreateChatButton"
        app:layout_constraintEnd_toEndOf="@id/newLayoutCreateChatButton"
        app:layout_constraintStart_toStartOf="@id/newLayoutCreateChatButton"
        app:tint="@android:color/white"
        tools:targetApi="lollipop_mr1"
        tools:visibility="visible" />


    <LinearLayout
        android:id="@+id/telegramBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_telegram_bottom_navigation"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/telegramTabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="true">

            <ImageView
                android:id="@+id/telegramTabChatsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/telegram_tab_chats"
                android:duplicateParentState="true"
                android:visibility="gone"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_bottom_chat"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabChatsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_chats"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="12sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabContactsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/telegram_tab_contacts"
                android:duplicateParentState="true"
                android:visibility="gone"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_baseline_perm_contact_calendar_24"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabContactsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_contacts"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="12sp"
                />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/telegram_tab_settings"
                android:duplicateParentState="true"
                android:visibility="gone"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_root_general"
                android:tint="@color/telegram_bottom_tab_tint" />

            <TextView
                android:id="@+id/telegramTabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_settings"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="12sp"
                />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/telegramTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_telegram_home_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:selected="false">

            <ImageView
                android:id="@+id/telegramTabProfileIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/telegram_tab_profile"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_round"
                />

            <TextView
                android:id="@+id/telegramTabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/telegram_tab_profile"
                android:textColor="@color/telegram_bottom_tab_tint"
                android:textSize="12sp"
                />

        </LinearLayout>


    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/telegramCameraFab"
        style="@style/Widget.Vector.FloatingActionButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/telegram_camera_action"
        android:src="@drawable/ic_camera_plain"
        android:visibility="visible"
        app:backgroundTint="?vctr_room_list_background"
        app:borderWidth="1dp"
        app:elevation="3dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/newLayoutCreateChatButton"
        app:layout_constraintEnd_toEndOf="@id/newLayoutCreateChatButton"
        app:maxImageSize="18dp"
        app:tint="?vctr_content_secondary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newLayoutCreateChatButton"
        style="@style/Widget.Vector.FloatingActionButton"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/a11y_create_message"
        android:src="@drawable/ic_fab_add_chat"
        android:visibility="gone"
        app:backgroundTint="@color/telegram_accent_blue"
        app:fabSize="mini"
        app:maxImageSize="24dp"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/telegramBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        tools:targetApi="lollipop_mr1"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>
