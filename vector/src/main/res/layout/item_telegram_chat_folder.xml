<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/telegramChatFolderRow"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/telegramChatFolderMore"
        android:layout_width="30dp"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/telegram_home_menu"
        android:padding="8dp"
        android:src="@drawable/ic_chat_folder_more"
        android:tint="?vctr_content_tertiary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/telegramChatFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?vctr_content_primary"
            android:textSize="16sp"
            tools:text="Personal" />

        <TextView
            android:id="@+id/telegramChatFolderFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?vctr_content_secondary"
            android:textSize="12sp"
            tools:text="Direct chats" />

    </LinearLayout>

    <ImageView
        android:id="@+id/telegramChatFolderDrag"
        android:layout_width="34dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/telegram_folder_action_move_up"
        android:padding="7dp"
        android:src="@drawable/ic_chat_folder_drag"
        android:tint="@color/telegram_folder_drag_tint" />
</LinearLayout>
