<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the doodle artwork at its native 360x640dp scale while the IME resizes the chat. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vctr_chat_background" />
        </shape>
    </item>
    <item
        android:width="360dp"
        android:height="640dp"
        android:gravity="top|center_horizontal"
        android:drawable="@drawable/bg_telegram_chat_doodles_pattern" />
</layer-list>
